{
  "name": "doqyn-alpha-document-intelligence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev:api\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "tsx server/dev-server.ts",
    "dev:worker": "tsx server/workers/runAnalysisWorker.ts",
    "dev:worker:preview": "tsx server/workers/runPreviewWorker.ts",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:server && tsc -b && vite build",
    "start:api": "node dist/server/production-server.js",
    "start:worker": "node dist/server/workers/runAnalysisWorker.js",
    "start:worker:preview": "node dist/server/workers/runPreviewWorker.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"api/**/*.ts\" \"server/**/*.ts\"",
    "favicon:build": "tsx scripts/optimize-favicon.ts",
    "db:setup": "tsx server/db/setupMongo.ts",
    "dev:seed:demo": "tsx scripts/demo-seed/index.ts",
    "audit:demo-consistency": "tsx scripts/audit-demo-consistency.ts",
    "audit:mongodb-schema": "tsx scripts/audit-mongodb-schema.ts",
    "audit:collection-usage": "tsx scripts/audit-collection-usage.ts",
    "audit:governance-rules": "tsx scripts/audit-governance-rules.ts",
    "mongo:audit": "node scripts/mongo-audit.mjs",
    "mongo:backup": "bash scripts/mongo-backup-before-cleanup.sh",
    "mongo:cleanup:dry-run": "node scripts/mongo-cleanup-legacy.mjs --dry-run",
    "mongo:cleanup:execute": "node scripts/mongo-cleanup-legacy.mjs --execute",
    "audit:no-flat-writes": "tsx scripts/assert-no-flat-tenant-writes.ts",
    "db:ensure-indexes": "tsx scripts/ensure-mongodb-indexes.ts",
    "db:backfill-search-meta": "tsx scripts/backfill-document-search-meta.ts",
    "db:drop-empty-legacy": "tsx scripts/drop-empty-legacy-collections.ts",
    "db:migrate-flat-to-tenant": "tsx scripts/migrate-flat-to-tenant-prefixed.ts",
    "db:migrate-keycloak-to-auth-user-id": "tsx scripts/migrate-keycloak-to-auth-user-id.ts",
    "db:seed-isolation-test": "tsx scripts/seed-second-tenant-isolation-test.ts",
    "db:cleanup-orphan-groups": "tsx scripts/cleanup-dev-orphan-groups.ts",
    "db:sanitize-audit-logs": "tsx scripts/sanitize-existing-audit-logs.ts",
    "db:fix-version-storage": "tsx scripts/fix-dev-document-version-storage.ts",
    "audit:document-versions": "tsx scripts/audit-document-versions.ts",
    "trash:purge-expired": "tsx scripts/trash-purge-expired.ts",
    "test:tenant-isolation": "tsx scripts/test-tenant-isolation.ts",
    "db:mongodb-isolation-report": "tsx scripts/generate-mongodb-isolation-final-report.ts",
    "deploy:setup": "./deploy/scripts/setup-production-env.sh",
    "deploy:production": "./deploy/scripts/deploy-production.sh",
    "test:groq:smoke": "tsx scripts/test-groq-smoke.mjs",
    "test:groq:fixture": "tsx scripts/test-groq-fixture.mjs",
    "test:groq:pdf": "tsx scripts/test-groq-pdf.mjs",
    "test:no-ai": "tsx scripts/test-no-ai.mjs",
    "env:audit": "node scripts/r2-env-check.mjs",
    "env:auth-sync": "node scripts/env-auth-sync-check.mjs",
    "r2:env-check": "node scripts/r2-env-check.mjs",
    "r2:smoke": "tsx scripts/r2-smoke-test.ts",
    "r2:audit-buckets": "tsx scripts/r2-audit-buckets.ts",
    "r2:cleanup-empty-demo-buckets": "tsx scripts/r2-cleanup-empty-demo-buckets.ts",
    "dev:reset:mongo": "tsx scripts/dev-reset-mongo.ts",
    "geoip:preload": "node -e \"import('geolite2-redist').then((m) => m.downloadDbs({ dbList: [m.GeoIpDbName.City] }))\"",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1077.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/orbitron": "^5.2.8",
    "@google-cloud/vision": "^5.3.7",
    "@hookform/resolvers": "^5.0.1",
    "@tanstack/react-query": "^5.74.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "dotenv": "^16.5.0",
    "geoip-lite": "^2.0.3",
    "geolite2-redist": "^3.1.3",
    "groq-sdk": "^1.3.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "libphonenumber-js": "^1.13.9",
    "material-symbols": "^0.45.6",
    "maxmind": "^5.0.6",
    "mime-types": "^3.0.1",
    "mongodb": "^7.3.0",
    "nanoid": "^5.1.5",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.10.38",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.0",
    "react-router-dom": "^7.5.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.15.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vercel/node": "^5.1.14",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.3"
  }
}
