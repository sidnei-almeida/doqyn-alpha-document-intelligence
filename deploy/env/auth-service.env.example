# doqyn-auth-service — espelho do .env.example do repositório auth.
# Copie para o .env do doqyn-auth-service (NÃO use SESSION_SECRET — não existe no auth).
#
# Produção VPS: use ./scripts/setup-production-env.sh no auth-service
# ou o setup-production-env.sh do alpha (gera o par de chaves internas).

PORT=4100
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://doqyn_auth:change-me@localhost:5433/doqyn_auth
DATABASE_URL_DIRECT=postgresql://doqyn_auth:change-me@localhost:5433/doqyn_auth

# Redis — rate limit distribuído (obrigatório com N réplicas)
REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=doqyn:
# Só usa Redis se REDIS_ENABLED=true e REDIS_URL estiver setado
RATE_LIMIT_REDIS_ENABLED=true

SESSION_COOKIE_NAME=doqyn_session
SESSION_TTL_DAYS=7
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

ALLOWED_ORIGINS=http://localhost:5173

# Alpha → auth (Bearer nas rotas /internal/*)
DOQYN_INTERNAL_API_KEY=change-me
# Auth → alpha (provision + member sync). Em production: ≥24 chars, sem valor de exemplo.
DOQYN_APP_BASE_URL=http://127.0.0.1:3001
DOQYN_APP_INTERNAL_API_KEY=dev-app-internal-api-key-change-in-production

DATA_ENCRYPTION_KEY=change-me-base64-32-bytes
LOOKUP_HASH_SECRET=change-me
SESSION_TOKEN_HASH_SECRET=change-me
PASSWORD_RESET_TOKEN_HASH_SECRET=change-me
PASSWORD_PEPPER=optional-change-me

PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24

DOQYN_APP_PUBLIC_URL=http://localhost:5173
EMAIL_FROM=noreply@doqyn.com.br
EMAIL_ENABLED=false
INVITE_TTL_DAYS=7
EMAIL_CHANGE_ENABLED=false
EMAIL_CHANGE_TTL_HOURS=24

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

OAUTH_GOOGLE_ENABLED=true
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://127.0.0.1:4100/oauth/google/callback

OAUTH_MICROSOFT_ENABLED=false
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=common
OAUTH_MICROSOFT_REDIRECT_URI=http://127.0.0.1:4100/oauth/microsoft/callback

OAUTH_POST_LOGIN_REDIRECT_URL=http://localhost:5173/auth/oauth/callback
OAUTH_ERROR_REDIRECT_URL=http://localhost:5173/login
