# doqyn-auth-service — exemplo de variáveis para desenvolvimento local.
# Copie para o .env do repositório doqyn-auth-service e ajuste os segredos.

PORT=4100
DATABASE_URL=postgresql://doqyn_auth:doqyn_auth_password@localhost:5433/doqyn_auth

# Sessão / cookies
SESSION_SECRET=troque-este-segredo
COOKIE_SECURE=false

# Google OAuth (secrets NUNCA vão para o frontend)
OAUTH_GOOGLE_ENABLED=true
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://127.0.0.1:4100/oauth/google/callback

# Microsoft OAuth — desabilitado por enquanto
OAUTH_MICROSOFT_ENABLED=false

# Redirecionamentos pós-OAuth para o frontend
OAUTH_POST_LOGIN_REDIRECT_URL=http://localhost:5173/auth/oauth/callback
OAUTH_ERROR_REDIRECT_URL=http://localhost:5173/login
