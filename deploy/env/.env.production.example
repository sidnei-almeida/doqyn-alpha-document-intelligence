# Template de produção — copie para deploy/.env e preencha os valores.
# Recomendado: ./deploy/scripts/setup-production-env.sh (gera deploy/.env com segredos).

COMPOSE_PROJECT_NAME=doqyn
AUTH_SERVICE_DIR=../../doqyn-auth-service
HTTP_PORT=80

# URL pública (HTTPS em produção real)
DOQYN_PUBLIC_APP_URL=https://app.exemplo.com

# Postgres (auth)
POSTGRES_DB=doqyn_auth
POSTGRES_USER=doqyn_auth
POSTGRES_PASSWORD=CHANGE_ME

# Auth-service
PORT=4100
NODE_ENV=production
# API runtime: via PgBouncer | migrations/Prisma directUrl: Postgres direto
DATABASE_URL=postgresql://doqyn_auth:CHANGE_ME@pgbouncer:5432/doqyn_auth
DATABASE_URL_DIRECT=postgresql://doqyn_auth:CHANGE_ME@postgres-auth:5432/doqyn_auth
SESSION_COOKIE_NAME=doqyn_session
SESSION_TTL_DAYS=7
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
ALLOWED_ORIGINS=https://app.exemplo.com
DOQYN_INTERNAL_API_KEY=CHANGE_ME
DOQYN_APP_BASE_URL=http://doqyn-api:3001
DOQYN_APP_INTERNAL_API_KEY=CHANGE_ME
DOQYN_APP_PUBLIC_URL=https://app.exemplo.com
DATA_ENCRYPTION_KEY=CHANGE_ME
LOOKUP_HASH_SECRET=CHANGE_ME
SESSION_TOKEN_HASH_SECRET=CHANGE_ME
PASSWORD_RESET_TOKEN_HASH_SECRET=CHANGE_ME
PASSWORD_PEPPER=CHANGE_ME

# Alpha API
APP_ENV=production
AUTH_PROVIDER=doqyn_auth
API_PORT=3001
DOQYN_AUTH_BASE_URL=http://auth-api:4100
DOQYN_AUTH_INTERNAL_API_KEY=CHANGE_ME
DOQYN_AUTH_COOKIE_NAME=doqyn_session
MONGODB_URI=mongodb://mongo:27017/doqyn_prod
MONGODB_DATABASE=doqyn_prod
# true = Atlas (sem container mongo) | false = profile local-mongo no compose
MONGODB_USE_ATLAS=false
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET_MODE=per_tenant
R2_DEFAULT_BUCKET=
R2_BUCKET_PREFIX=doqyn
R2_KEY_PREFIX=documents
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ADMIN_ACCESS_KEY_ID=
R2_ADMIN_SECRET_ACCESS_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
DOCUMENT_ANALYSIS_PROVIDER=groq

# Google Cloud Vision — OCR (PDF escaneado / imagem)
# No Docker: JSON em deploy/secrets/gcp-vision-sa.json montado em /run/secrets/
VISION_OCR_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-vision-sa.json
VISION_OCR_MAX_PAGES=20
VISION_OCR_MIN_TEXT_CHARS=300

# Redis (fila BullMQ + cache de sessão + quotas)
REDIS_URL=redis://redis:6379
REDIS_ENABLED=true
REDIS_KEY_PREFIX=doqyn:
RATE_LIMIT_REDIS_ENABLED=true

# PgBouncer
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_DEFAULT_POOL_SIZE=25

# Réplicas (Fase B.4)
AUTH_API_REPLICAS=2
DOQYN_API_REPLICAS=2

# Upload presigned R2 (Fase B.5)
PRESIGNED_UPLOAD_ENABLED=true
PRESIGNED_UPLOAD_TTL_SECONDS=900
VITE_PRESIGNED_UPLOAD_ENABLED=true

# Fila de análise assíncrona
ANALYSIS_SYNC_FALLBACK=false
ANALYSIS_QUEUE_CONCURRENCY_GLOBAL=10
ANALYSIS_QUEUE_CONCURRENCY_PER_TENANT=2
ANALYSIS_JOB_TTL_HOURS=24

# Fila de preview assíncrona (Ghostscript)
PREVIEW_SYNC_FALLBACK=false
PREVIEW_QUEUE_CONCURRENCY_GLOBAL=4
PREVIEW_JOB_TTL_HOURS=24

# MongoDB pool
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# Cache de sessão auth
SESSION_CACHE_ENABLED=true
SESSION_CACHE_TTL_SECONDS=45

# Quotas por tenant
TENANT_QUOTA_ENABLED=true
TENANT_QUOTA_ANALYSIS_PER_DAY=200
TENANT_QUOTA_UPLOADS_PER_HOUR=60

# Prometheus
METRICS_ENABLED=true
# METRICS_TOKEN=gerado por setup-production-env.sh
METRICS_SERVICE_NAME=doqyn-api
METRICS_PORT=9100

# Observabilidade (profile opcional — Prometheus + Grafana)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# GRAFANA_ADMIN_PASSWORD=gerado por setup-production-env.sh
OBSERVABILITY_ENABLE=true

# Frontend (build-time nginx)
VITE_APP_NAME=DOQYN
VITE_AUTH_PROVIDER=doqyn_auth
VITE_AUTH_BASE_PATH=/auth
VITE_UPLOAD_ANALYZE_TIMEOUT_MS=60000
