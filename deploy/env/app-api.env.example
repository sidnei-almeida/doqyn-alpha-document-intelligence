# doqyn-alpha (document-api) — exemplo de variáveis para desenvolvimento local.
# Copie para o .env na raiz deste repositório e ajuste conforme o ambiente.

PORT=3001

# MongoDB (compose dev local ou Atlas)
MONGODB_URI=mongodb://localhost:27017/doqyn_dev

# Auth-service (validação de sessão)
DOQYN_AUTH_BASE_URL=http://127.0.0.1:4100

# Storage: r2 (produção) ou local (dev sem credenciais Cloudflare)
STORAGE_PROVIDER=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# IA (análise de PDF) — ver docs/INFERENCIA.md
DOCUMENT_ANALYSIS_PROVIDER=groq
# Fornecedor de inferência: groq (padrão) ou fireworks.
# INFERENCE_PROVIDER=fireworks
# FIREWORKS_API_KEY=
# GROQ_API_KEY=
# O limitador usa os nomes GROQ_* nos dois fornecedores. O Fireworks não informa limite em
# cabeçalho, então sem estas duas o teto cai em 25 pedidos / 6.000 tokens por minuto.
# GROQ_MAX_REQUESTS_PER_MINUTE=3000
# GROQ_MAX_TOKENS_PER_MINUTE=3000000
# GROQ_REQUEST_TIMEOUT_MS=45000
# PDF_ANALYSIS_MAX_PAGES=300
# PDF_ANALYSIS_MAX_INPUT_CHARS=1000000
# EXTRACTION_MAX_CHUNKS=40
# EXTRACTION_REFINEMENT_ENABLED=false
# MAX_UPLOAD_MB=50

# Google Cloud Vision — OCR (opcional; desligado por padrão)
# VISION_OCR_ENABLED=false
# GOOGLE_APPLICATION_CREDENTIALS=./deploy/secrets/gcp-vision-sa.json
# VISION_OCR_MAX_PAGES=20
# VISION_OCR_MIN_TEXT_CHARS=300
# VISION_OCR_DPI=150
# VISION_OCR_TIMEOUT_MS=60000

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true
REDIS_KEY_PREFIX=doqyn:alpha:

# Fila assíncrona
ANALYSIS_SYNC_FALLBACK=false
ANALYSIS_QUEUE_CONCURRENCY_GLOBAL=10

# Prometheus
METRICS_ENABLED=true

# Mongo pool
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
