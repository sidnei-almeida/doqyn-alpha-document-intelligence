# doqyn-alpha (frontend Vite) — exemplo de variáveis para desenvolvimento local.
# Copie os valores necessários para o .env deste repositório.
# Nenhum segredo OAuth vive aqui: o fluxo inteiro passa pelo auth-service.

VITE_APP_NAME=DOQYN
VITE_AUTH_PROVIDER=doqyn_auth
VITE_AUTH_MODE=temporary

# Fila de upload da Biblioteca: false = sempre revisar antes de salvar (recomendado).
# VITE_UPLOAD_AUTO_CONFIRM_ENABLED=false

# Proxies do Vite (já configurados em vite.config.ts):
#   /api    -> http://localhost:3001
#   /auth   -> http://localhost:4100
#   /oauth  -> http://localhost:4100
