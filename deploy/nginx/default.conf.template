# Renderizado pelo entrypoint da imagem nginx (envsubst sobre /etc/nginx/templates).
# Só variáveis com prefixo LETSENCRYPT_ são substituídas (NGINX_ENVSUBST_FILTER no
# compose) — as variáveis do próprio nginx ($host, $uri, ...) passam intactas porque
# o envsubst da imagem só troca a forma ${NOME}.

# DNS interno Docker — necessário para balancear múltiplas réplicas (compose scale).
resolver 127.0.0.11 valid=10s ipv6=off;

upstream doqyn_api {
  zone doqyn_api 64k;
  least_conn;
  server doqyn-api:3001 resolve;
  keepalive 32;
}

upstream doqyn_auth {
  zone doqyn_auth 64k;
  least_conn;
  server auth-api:4100 resolve;
  keepalive 16;
}

map $http_user_agent $is_social_bot {
  default 0;
  ~*(facebookexternalhit|whatsapp|twitterbot|linkedinbot|slackbot|telegrambot|discordbot|googlebot|bingbot|applebot|embedly) 1;
}

# Porta 80: só desafio ACME e redirect. Nada da app responde em texto claro — o
# cookie de sessão é Secure, então servir a SPA aqui só produziria login quebrado.
server {
  listen 80;
  server_name _;

  # Healthcheck do container. Precisa de resposta própria: seguir o 301 levaria o
  # wget ao domínio público, que de dentro do container pode nem resolver.
  location = /nginx-health {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  # Raiz do webroot compartilhada com o container certbot na renovação.
  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type "text/plain";
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${LETSENCRYPT_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${LETSENCRYPT_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${LETSENCRYPT_DOMAIN}/privkey.pem;

  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  # 6 meses. Sem preload: entrar na lista é praticamente irreversível e travaria
  # qualquer subdomínio futuro que ainda não tenha certificado.
  add_header Strict-Transport-Security "max-age=15768000" always;

  # Folga sobre os 50 MB do upload (MAX_UPLOAD_MB): o corpo multipart pesa mais que o arquivo.
  client_max_body_size 60m;
  root /usr/share/nginx/html;

  # Rotas antigas em português → as novas, em inglês. 301 de verdade, e não redirect no app: há
  # link desses endereços em e-mail já entregue e em convite em circulação. A query é preservada
  # sozinha pelo `permanent`. A lista é `src/app/legacyRoutes.ts`, e `tests/legacy-routes.test.ts`
  # confere que cada entrada dela está aqui. O específico vem antes do geral.
  rewrite ^/biblioteca/compartilhados(/.*)?$ /library/shared$1 permanent;
  rewrite ^/biblioteca/assinaturas(/.*)?$ /library/signatures$1 permanent;
  rewrite ^/biblioteca/recentes(/.*)?$ /library/recent$1 permanent;
  rewrite ^/biblioteca/favoritos(/.*)?$ /library/favorites$1 permanent;
  rewrite ^/biblioteca/lixeira(/.*)?$ /library/trash$1 permanent;
  rewrite ^/biblioteca/desativados(/.*)?$ /library/deactivated$1 permanent;
  rewrite ^/biblioteca(/.*)?$ /library$1 permanent;
  rewrite ^/pedidos(/.*)?$ /requests$1 permanent;
  rewrite ^/contatos(/.*)?$ /contacts$1 permanent;
  rewrite ^/notificacoes(/.*)?$ /notifications$1 permanent;
  rewrite ^/termos(/.*)?$ /terms$1 permanent;
  rewrite ^/convite(/.*)?$ /invite$1 permanent;
  rewrite ^/criar-empresa(/.*)?$ /signup/company$1 permanent;
  rewrite ^/criar-acesso-cpf(/.*)?$ /signup/individual$1 permanent;
  rewrite ^/confirmar-cadastro(/.*)?$ /verify-email$1 permanent;
  rewrite ^/verificar-email(/.*)?$ /verify-email$1 permanent;
  rewrite ^/confirmar-email(/.*)?$ /confirm-email-change$1 permanent;
  rewrite ^/acesso(/.*)?$ /access$1 permanent;
  rewrite ^/assinaturas(/.*)?$ /signatures$1 permanent;
  rewrite ^/matriz(/.*)?$ /access-matrix$1 permanent;

  # O nginx não conhece `.mjs` e o serve como `application/octet-stream`. O navegador recusa
  # módulo ES com esse tipo, e o pdf.js cai no "fake worker": renderiza na thread principal.
  #
  # Resolvido por `location`, e não por um bloco `types` — este SUBSTITUI o mapa inteiro de tipos
  # em vez de acrescentar. Declarar só o `mjs` apagava `text/html` junto, e o navegador passava a
  # BAIXAR o index.html em vez de abrir o app.
  location ~ \.mjs$ {
    default_type application/javascript;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
  index index.html;

  # Métricas Prometheus — apenas rede interna (scrape direto no container API).
  location = /api/metrics {
    return 403;
  }

  location /api/ {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_read_timeout 120s;
    proxy_pass http://doqyn_api;
  }

  location /auth/ {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://doqyn_auth/auth/;
  }

  location /oauth/ {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://doqyn_auth/oauth/;
  }

  location = /health {
    proxy_pass http://doqyn_auth/health;
  }

  location ~ ^/guest/share/(?<token>[^/]+)$ {
    if ($is_social_bot) {
      rewrite ^ /api/og/guest/share/$token last;
    }
    try_files $uri $uri/ /index.html;
  }

  location ~ ^/guest/sign/(?<token>[^/]+)$ {
    if ($is_social_bot) {
      rewrite ^ /api/og/guest/sign/$token last;
    }
    try_files $uri $uri/ /index.html;
  }

  location ~ ^/share/(?<token>[^/]+)$ {
    if ($is_social_bot) {
      rewrite ^ /api/og/guest/share/$token last;
    }
    try_files $uri $uri/ /index.html;
  }

  location ~ ^/sign/(?<token>[^/]+)$ {
    if ($is_social_bot) {
      rewrite ^ /api/og/guest/sign/$token last;
    }
    try_files $uri $uri/ /index.html;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
