# API DOQYN — Node + Ghostscript (preview PDF) + sharp
# Produção: API compilada (node dist) — Fase B.1

FROM node:22-bookworm-slim AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci --include=dev; else npm install; fi

COPY api ./api
COPY server ./server
COPY shared ./shared
COPY scripts/build-server.mjs ./scripts/build-server.mjs
COPY scripts/ensure-mongodb-indexes.ts ./scripts/ensure-mongodb-indexes.ts
COPY scripts/lib ./scripts/lib

RUN npm run build:server

FROM node:22-bookworm-slim AS runner

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ghostscript ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 --ingroup nodejs --home /home/nodejs nodejs \
  && mkdir -p /home/nodejs /app/.npm

COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi

ENV NODE_ENV=production

COPY --from=builder /app/dist ./dist
COPY public ./public

RUN mkdir -p docs data/geoip \
  && chown -R nodejs:nodejs /app /home/nodejs

ENV HOME=/home/nodejs
ENV NPM_CONFIG_CACHE=/app/.npm

USER nodejs

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${API_PORT:-3001}/api/health" || exit 1

CMD ["node", "dist/server/production-server.js"]
