# API DOQYN — Node + Ghostscript (preview PDF) + sharp
# Produção: API compilada (node dist) — Fase B.1

FROM node:22-bookworm-slim AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci --include=dev; else npm install; fi

COPY api ./api
COPY server ./server
COPY shared ./shared
# Catálogos de tradução que o servidor importa (build-server copia para dist/).
COPY src/i18n/catalog ./src/i18n/catalog
# `scripts/` inteiro, não um arquivo por linha: esta lista tinha de bater com a `SCRIPT_ROOTS` do
# `build-server.mjs`, e não batia. `enable-expiry-alerts-defaults.ts` estava na lista do build e
# nunca chegou na imagem — build-server simplesmente não achava o arquivo e seguia calado. Copiar a
# pasta não engorda `dist/`, porque quem decide o que é compilado continua sendo o `SCRIPT_ROOTS`.
COPY scripts ./scripts

RUN npm run build:server

FROM node:22-bookworm-slim AS runner

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ghostscript ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 --ingroup nodejs --home /home/nodejs nodejs \
  && mkdir -p /home/nodejs /app/.npm

COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi

ENV NODE_ENV=production

COPY --from=builder /app/dist ./dist
COPY public ./public

RUN mkdir -p docs data/geoip \
  && chown -R nodejs:nodejs /app /home/nodejs

ENV HOME=/home/nodejs
ENV NPM_CONFIG_CACHE=/app/.npm

USER nodejs

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${API_PORT:-3001}/api/health" || exit 1

CMD ["node", "dist/server/production-server.js"]
