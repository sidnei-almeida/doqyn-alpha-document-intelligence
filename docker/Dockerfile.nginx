# Nginx único: build do frontend + proxy /api /auth /oauth
FROM node:22-alpine AS builder

WORKDIR /app

ARG VITE_APP_NAME=DOQYN
ARG VITE_AUTH_PROVIDER=doqyn_auth
ARG VITE_AUTH_BASE_PATH=/auth
ARG VITE_REACT_FLOW_HIDE_ATTRIBUTION=true
ARG VITE_REACT_FLOW_SHOW_MINIMAP=false
ARG VITE_PRESIGNED_UPLOAD_ENABLED=false

ENV VITE_APP_NAME=$VITE_APP_NAME
ENV VITE_AUTH_PROVIDER=$VITE_AUTH_PROVIDER
ENV VITE_AUTH_BASE_PATH=$VITE_AUTH_BASE_PATH
ENV VITE_REACT_FLOW_HIDE_ATTRIBUTION=$VITE_REACT_FLOW_HIDE_ATTRIBUTION
ENV VITE_REACT_FLOW_SHOW_MINIMAP=$VITE_REACT_FLOW_SHOW_MINIMAP
ENV VITE_PRESIGNED_UPLOAD_ENABLED=$VITE_PRESIGNED_UPLOAD_ENABLED

COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

# tsconfig.server.json entra junto porque tsconfig.json o lista em "references", e o
# plugin vite:build-html percorre as três referências ao ler o index.html. Sem o
# arquivo, o build morre com ENOENT antes de transformar um único módulo.
COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json tsconfig.server.json postcss.config.js tailwind.config.js ./
COPY src ./src
COPY shared ./shared
COPY public ./public

RUN npx vite build

FROM nginx:1.27-alpine AS runner

# Template, não conf pronta: o entrypoint da imagem roda envsubst sobre
# /etc/nginx/templates e escreve o resultado em /etc/nginx/conf.d. É assim que
# ${LETSENCRYPT_DOMAIN} chega ao caminho do certificado sem hardcode.
COPY deploy/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80 443

# O certbot renova o certificado no volume compartilhado, mas o nginx só passa a
# usá-lo depois de reler os arquivos. Sem este loop, o certificado renovado fica
# em disco e o navegador continua vendo o antigo até expirar.
CMD ["sh", "-c", "while :; do sleep 6h & wait $!; nginx -s reload; done & exec nginx -g 'daemon off;'"]

# Bate na porta 80, que responde 200 direto sem redirect. Seguir o 301 mandaria o
# wget ao domínio público — resolução e rota que não existem dentro do container.
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/nginx-health >/dev/null || exit 1
