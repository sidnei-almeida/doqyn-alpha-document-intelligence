# Frontend (public)
VITE_APP_NAME=DOQYN
VITE_AUTH_PROVIDER=doqyn_auth
VITE_AUTH_BASE_PATH=/auth

# React Flow (mapa de governança em /rules)
# React Flow é MIT, mas o projeto recomenda manter attribution ou assinar Pro em uso comercial.
# Em builds internos/demo, podemos ocultar para manter a UI limpa.
VITE_REACT_FLOW_HIDE_ATTRIBUTION=true
VITE_REACT_FLOW_SHOW_MINIMAP=false

# =============================================================================
# === SYNC Auth↔Alpha (P0) — validar com: npm run env:auth-sync ===
# Doc: docs/ENV_SYNC.md
# =============================================================================
# AUTH_PROVIDER e VITE_AUTH_PROVIDER devem ser doqyn_auth (VITE_ no topo deste arquivo).
AUTH_PROVIDER=doqyn_auth
DOQYN_AUTH_BASE_URL=http://127.0.0.1:4100
# Idêntico a DOQYN_INTERNAL_API_KEY no doqyn-auth-service
DOQYN_AUTH_INTERNAL_API_KEY=
# Idêntico a SESSION_COOKIE_NAME no doqyn-auth-service
DOQYN_AUTH_COOKIE_NAME=doqyn_session
# Idêntico a DOQYN_APP_INTERNAL_API_KEY no doqyn-auth-service (provision/sync)
DOQYN_APP_INTERNAL_API_KEY=dev-app-internal-api-key-change-in-production
# Origem do FE — Auth.ALLOWED_ORIGINS deve incluir esta origem
# Idealmente igual a Auth.DOQYN_APP_PUBLIC_URL
DOQYN_PUBLIC_APP_URL=http://localhost:5173

# Application
APP_ENV=development
MONGODB_URI=
MONGODB_DATABASE=doqyn_dev
MONGODB_TENANT_ID=company_dev
MONGODB_COMPANY_ID=company_dev

# Legado — autenticação JWT local (não usar com AUTH_PROVIDER=doqyn_auth)
# TEMP_AUTH_ENABLED=true
# JWT_SECRET=
# AUTH_COOKIE_NAME=doqyn_session

# AI / Processing — Groq (server-side only; nunca usar prefixo VITE_)
GROQ_API_KEY=
# Recomendado Beta: Scout 17B (melhor que 8B, bem mais barato que 70B)
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MAX_OUTPUT_TOKENS=1200
# llama-3.1-8b-instant = mais barato | llama-3.3-70b-versatile = caro / TPD baixo no free
PDF_ANALYSIS_MAX_INPUT_CHARS=30000
PDF_ANALYSIS_MAX_PAGES=10
# Modelos opcionais por etapa (default: GROQ_MODEL)
# GROQ_CLASSIFIER_MODEL=
# GROQ_EXTRACTOR_MODEL=
# Limites gratuitos da Groq: reduza PDF_ANALYSIS_MAX_INPUT_CHARS ou use modelo menor se ver 429.
# Timeout por chamada à API Groq (ms). Classificação + extração rodam em sequência.
GROQ_REQUEST_TIMEOUT_MS=25000
# TEMP: logs verbosos do pipeline IA/OCR (grep AI_PIPELINE_DEBUG). Default off.
AI_PIPELINE_DEBUG=false

# Frontend — timeout da fila de upload ao aguardar analyzePdf (ms, 30s–90s)
VITE_UPLOAD_ANALYZE_TIMEOUT_MS=60000

# API local
API_PORT=3001
# Produção (após npm run build:server): npm run start:api | npm run start:worker

# Redis (fila BullMQ, cache de sessão, quotas)
REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379
# Isolado do Auth (doqyn:auth:) para Redis compartilhado
REDIS_KEY_PREFIX=doqyn:alpha:

# MongoDB pool
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
# true = Atlas (URI mongodb+srv) | false = container mongo no Docker Compose
# MONGODB_USE_ATLAS=false
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Provedor de análise de documentos (groq | google_vision)
# Classificação/extração: groq. OCR de PDF escaneado/imagem: Vision API (abaixo).
DOCUMENT_ANALYSIS_PROVIDER=groq

# Google Cloud Vision — OCR (PDF escaneado / imagem). Credenciais fora do git.
# Coloque o JSON em deploy/secrets/gcp-vision-sa.json (já ignorado pelo .gitignore).
VISION_OCR_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=./deploy/secrets/gcp-vision-sa.json
# VISION_OCR_MAX_PAGES=20
# VISION_OCR_MIN_TEXT_CHARS=300
# VISION_OCR_DPI=150
# VISION_OCR_TIMEOUT_MS=60000

# Fila de análise assíncrona (requer REDIS_URL + storage configurado)
# ATENÇÃO: dimensione a concorrência ao número de vCPUs, não deixe no default.
# Os defaults do código (10 + 4 = 14 jobs) assumem uma máquina grande. Em 2 vCPU,
# o compose de produção sobrescreve para 2 / 1 / 1 — ver docs/PLANO_ACAO_ESCALA_2026-07-20.md.
ANALYSIS_SYNC_FALLBACK=true
# ANALYSIS_QUEUE_CONCURRENCY_GLOBAL=10      # default do código; 2 vCPU => use 2
# ANALYSIS_QUEUE_CONCURRENCY_PER_TENANT=2   # default do código; 2 vCPU => use 1
# ANALYSIS_JOB_TTL_HOURS=24
# ANALYSIS_WORKER_IN_PROCESS=true

# Fila de preview assíncrona (Ghostscript — worker dedicado em produção)
PREVIEW_SYNC_FALLBACK=true
# PREVIEW_QUEUE_CONCURRENCY_GLOBAL=4        # cada job = 1 Ghostscript; 2 vCPU => use 1
# PREVIEW_JOB_TTL_HOURS=24

# Cache de sessão auth (requer Redis)
SESSION_CACHE_ENABLED=true
SESSION_CACHE_TTL_SECONDS=45

# Quotas por tenant (requer Redis)
TENANT_QUOTA_ENABLED=false
# Com Redis ligado em produção, use true. Sem Redis, fail-open (não bloqueia).
# TENANT_QUOTA_ENABLED=true
TENANT_QUOTA_ANALYSIS_PER_DAY=200
TENANT_QUOTA_UPLOADS_PER_HOUR=60

# Prometheus (métricas operacionais — scrape /api/metrics ou :9100 no worker)
METRICS_ENABLED=false
# METRICS_TOKEN=change-me-in-production
# METRICS_SERVICE_NAME=doqyn-api
# METRICS_SERVICE_ROLE=api
# METRICS_PORT=9100

# Storage
# r2 = Cloudflare R2 (produção) | local = disco local (legado/dev apenas)
STORAGE_PROVIDER=r2
# LOCAL_STORAGE_ROOT=/var/lib/doqyn-alpha/storage
MAX_UPLOAD_MB=25

# Upload presigned R2 (Fase B.5) — browser → R2 direto na análise
# Requer STORAGE_PROVIDER=r2 + CORS no bucket. Dev local: false.
# PRESIGNED_UPLOAD_ENABLED=false
# PRESIGNED_UPLOAD_TTL_SECONDS=900
# VITE_PRESIGNED_UPLOAD_ENABLED=false

# Cloudflare R2 (somente backend — nunca usar prefixo VITE_)
# STORAGE_PROVIDER=r2
# R2_BUCKET_MODE=per_tenant
# R2_DEFAULT_BUCKET=doqyn-alpha
# R2_BUCKET_PREFIX=doqyn
# R2_KEY_PREFIX=documents
# R2_ACCOUNT_ID=
# R2_ENDPOINT=
# R2_REGION=auto
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ADMIN_ACCESS_KEY_ID=
# R2_ADMIN_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_ADMIN_API_TOKEN=

# Avatar de perfil (prefixo profiles/users/{userId}/ — separado de documentos)
# PROFILE_AVATAR_MAX_SIZE_MB=5
# PROFILE_AVATAR_ALLOWED_TYPES=image/jpeg,image/png,image/webp
# PROFILE_AVATAR_OUTPUT_FORMAT=webp
# PROFILE_AVATAR_SIZES=64,128,256

# PDF preview (opcional — defaults seguros se ausente)
# PDF_PREVIEW_ENABLED=true
# PDF_PREVIEW_WATERMARK_TEXT=DOQYN  # legado: metadado textual; preview usa marca DOQYN colorida
# PDF_PREVIEW_GHOSTSCRIPT_PATH=gs
# PDF_PREVIEW_TIMEOUT_MS=60000
# PDF_PREVIEW_PROFILE=ebook
# PDF_PREVIEW_MAX_INPUT_MB=80
# PDF_PREVIEW_PAGE_DPI=180
# PDF_PREVIEW_THUMB_DPI=72
# IMAGE_PREVIEW_QUALITY=90

# Tracking / auditoria de segurança (somente backend)
# IP mascarado na UI; hash e IP criptografado restrito ao audit log interno.
# Gere com: openssl rand -hex 32
TRACKING_IP_ENCRYPTION_KEY=
TRACKING_IP_HASH_SALT=

# GeoIP offline (cidade/estado) — GeoLite2-City via geolite2-redist (download automático na 1ª execução).
# Opcional: apontar para um .mmdb próprio (ex.: MaxMind com licença comercial).
# GEOIP_CITY_DB_PATH=/caminho/para/GeoLite2-City.mmdb

# ---------------------------------------------------------------------------
# Limites de recurso do Compose de produção (deploy/.env)
# Orçamento padrão dimensionado para VPS 8GB / 2 vCPU com Mongo no Atlas.
# Soma dos mem_limit: ~5,3GB, deixando ~2,7GB para SO, page cache e picos.
# Os valores de `cpus` somam mais que 2 de propósito: são tetos por container,
# não reservas — nenhum serviço monopoliza, mas a capacidade ociosa é compartilhada.
# ---------------------------------------------------------------------------
# POSTGRES_MEM_LIMIT=1g
# POSTGRES_CPUS=0.5
# AUTH_API_MEM_LIMIT=512m
# AUTH_API_CPUS=0.5
# DOQYN_API_MEM_LIMIT=1g
# DOQYN_API_CPUS=0.8
# DOQYN_WORKER_MEM_LIMIT=1g
# DOQYN_WORKER_CPUS=0.8
# DOQYN_WORKER_PREVIEW_MEM_LIMIT=768m
# DOQYN_WORKER_PREVIEW_CPUS=0.6
# REDIS_MEM_LIMIT=900m
# REDIS_CPUS=0.3
# REDIS_MAXMEMORY=640mb
