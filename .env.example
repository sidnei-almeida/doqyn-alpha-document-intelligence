# Application
APP_ENV=development
MONGODB_URI=
# Database único usado pela API (analyze-pdf, confirm-analysis, db:setup)
MONGODB_DATABASE=doqyn_dev
# Tenant padrão para classes/regras seed e queries multi-empresa
MONGODB_TENANT_ID=company_dev
# LEGADO — alias de MONGODB_TENANT_ID
MONGODB_COMPANY_ID=company_dev
# LEGADO: não é lido pelo app. Use apenas MONGODB_DATABASE.
# MONGODB_DB_NAME=doqyn_alpha

# Frontend (public — never put secrets here)
VITE_APP_NAME=DOQYN
# Autenticação: keycloak (SSO real) | mock (dev sem Keycloak)
# Se VITE_AUTH_PROVIDER não estiver definido, usa VITE_AUTH_MODE=temporary (API/cookie)
VITE_AUTH_PROVIDER=mock
VITE_AUTH_MODE=temporary
VITE_KEYCLOAK_URL=http://127.0.0.1:8080
VITE_KEYCLOAK_REALM=doqyn
VITE_KEYCLOAK_CLIENT_ID=doqyn-web
# Opcional — redirect após logout Keycloak
# VITE_KEYCLOAK_LOGOUT_REDIRECT_URI=http://localhost:5173

# Temporary Auth (backend only — never use VITE_ prefix)
TEMP_AUTH_ENABLED=true
TEMP_ADMIN_EMAIL=admin@doqyn.com
# Gere com: node scripts/generate-password-hash.mjs sua_senha
TEMP_ADMIN_PASSWORD_HASH=
TEMP_ADMIN_NAME=Administrador DOQYN

TEMP_COMPANY_ID=company_dev
TEMP_COMPANY_NAME=DOQYN Alpha
TEMP_USER_ROLE=admin
TEMP_USER_AREA=Gestão
TEMP_USER_GROUPS=admin,financeiro,juridico,frete,rh

# Session (backend only)
# Obrigatório: mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=
AUTH_COOKIE_NAME=doqyn_session
AUTH_COOKIE_SECURE=false
# 43200 = 12 horas | com "Lembrar acesso" no login: 30 dias
AUTH_SESSION_MAX_AGE_SECONDS=43200

# Keycloak (backend only — never use VITE_ prefix for admin secret)
KEYCLOAK_BASE_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=doqyn
KEYCLOAK_ADMIN_CLIENT_ID=doqyn-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
KEYCLOAK_FRONTEND_CLIENT_ID=doqyn-web

# AI / Processing (backend only — never use VITE_ prefix)
# groq = fluxo real com Groq | no_ai = análise determinística para desenvolvimento
AI_MODE=groq
# Template usado quando AI_MODE=no_ai (apenas nda nesta etapa)
NO_AI_TEMPLATE=nda
GROQ_API_KEY=
# Opcional — padrão: llama-3.3-70b-versatile
GROQ_MODEL=
# Opcional — modelos separados para classificação e extração (fallback: GROQ_MODEL)
GROQ_CLASSIFIER_MODEL=
GROQ_EXTRACTOR_MODEL=
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=

# Storage (backend only — futuro)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
